<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="enocunter_subreport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" resourceBundle="encounter_report" uuid="98f99aa4-9059-4aef-bf14-57da053142cd">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="patID" class="java.lang.Integer"/>
	<parameter name="performedAt" class="java.sql.Timestamp"/>
	<parameter name="closedAt" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT * FROM oh_encounter enc
LEFT JOIN oh_medicalhistory mh 
    ON enc.ENC_PAT_ID = mh.MH_PAT_ID
   AND (mh.MH_CREATED_DATE >= enc.ENC_PERFORMED_AT AND (enc.ENC_CLOSED_AT IS NULL OR enc.ENC_CLOSED_AT >=mh.MH_CREATED_DATE))
LEFT JOIN oh_admission adm 
    ON enc.ENC_PAT_ID = adm.ADM_PAT_ID
   AND (adm.ADM_DATE_ADM >= enc.ENC_PERFORMED_AT AND ( enc.ENC_CLOSED_AT IS NULL OR  enc.ENC_CLOSED_AT>=adm.ADM_DATE_ADM))
LEFT JOIN oh_admissiontype admt
	ON adm.ADM_ADMT_ID_A_ADM = admt.ADMT_ID_A
WHERE enc.ENC_PAT_ID = $P{patID}
AND enc.ENC_STATUS <> "CANCELLED"
AND enc.ENC_PERFORMED_AT = $P{performedAt}
AND (enc.ENC_CLOSED_AT IS NULL OR enc.ENC_CLOSED_AT = $P{closedAt})
LIMIT 1]]>
	</queryString>
