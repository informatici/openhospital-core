	<queryString>
		<![CDATA[SELECT 
            lab.LAB_DATE,
            lab.LAB_PAT_ID,
            lab.LAB_SEX,
            lab.LAB_AGE,
            lab.LAB_PAT_NAME,
            exa.EXA_DESC AS EXA_NAME
        FROM oh_laboratory lab
        JOIN oh_exam exa ON lab.LAB_EXA_ID_A = exa.EXA_ID_A
        WHERE lab.LAB_PAT_ID = $P{patientId} AND lab.LAB_STATUS = 'Draft'
        ORDER BY lab.LAB_DATE, exa.EXA_DESC]]>
	</queryString>
	<field name="LAB_DATE" class="java.sql.Timestamp"/>
	<field name="LAB_PAT_ID" class="java.lang.Integer"/>
	<field name="LAB_SEX" class="java.lang.String"/>
	<field name="LAB_AGE" class="java.lang.Integer"/>
	<field name="LAB_PAT_NAME" class="java.lang.String"/>
	<field name="EXA_NAME" class="java.lang.String"/>
