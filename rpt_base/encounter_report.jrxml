	<parameter name="LOGO-BENIN-PATH" class="java.lang.String"/>
	<parameter name="LOGO-PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from oh_patient p
INNER JOIN oh_encounter e
ON p.PAT_ID = e.ENC_PAT_ID
 where p.PAT_ID = $P{patID}
AND e.ENC_PERFORMED_AT = $P{performedAt}
AND (e.ENC_CLOSED_AT IS NULL OR e.ENC_CLOSED_AT <= $P{closedAt})]]>
	</queryString>
