<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="encounter_conditionig_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" resourceBundle="encounter_report" uuid="1d84a217-be31-4617-8ae9-b9364b40af40">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="patID" class="java.lang.Integer"/>
	<parameter name="performedAt" class="java.sql.Timestamp"/>
	<parameter name="closedAt" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT * FROM oh_encounter enc
INNER JOIN oh_conditioning cond 
    ON enc.ENC_PAT_ID = cond.COND_PAT_ID
   AND (cond.COND_PERFORMED_AT >= enc.ENC_PERFORMED_AT AND (enc.ENC_CLOSED_AT IS NULL OR enc.ENC_CLOSED_AT >=cond.COND_PERFORMED_AT))
WHERE enc.ENC_PAT_ID = $P{patID}
AND enc.ENC_STATUS <> "CANCELLED"
AND enc.ENC_PERFORMED_AT = $P{performedAt}
AND (enc.ENC_CLOSED_AT IS NULL OR enc.ENC_CLOSED_AT = $P{closedAt})]]>
	</queryString>
